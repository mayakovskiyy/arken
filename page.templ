package main

templ page(name string, description string, bluesky string, tangled string, streamplace string, avatar string) {
	<header>
		<img src={ avatar } alt="Bsky Avatar">
		<h2>{ name }</h2>
		<p>{ description }</p>
		if bluesky != "" {
			<a href={ bluesky }>bluesky</a>
		}
		if tangled != "" {
			<a href={ tangled }>tangled</a>
		}
		if streamplace != "" {
			<p>streamplace: { streamplace }</p>
		}
	</header>
}
